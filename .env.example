# Деплой и версии
PYTHON_RELEASE=3.11-slim
DEPLOY_BRANCH=main
BACKEND_COMPOSE_NAME=zovoceana-backend-compose
VERSION=0.0.1
IMAGES_VOLUME_NAME=zovoceana-images

# Python и контейнеры
PYTHON_RELEASE=3.11-slim
APP_CONTAINER_NAME=zovoceana-backend-app
DB_CONTAINER_NAME=zovoceana-backend-db

# Сервер
HOST=0.0.0.0
PORT=9000
DEBUG=True
SAVE_IMAGES_TO_DB=False
SAVE_IMAGES_FOLDER=images

# CORS (разделяются запятой, без пробелов)
CORS_ORIGINS=http://localhost,https://localhost,http://127.0.0.1,https://127.0.0.1

# База данных (PostgreSQL)
POSTGRES_RELEASE=15.3-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_db_password>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zovoceana

# T-Банк (платежи)
TBANK_TERMINAL_KEY=<your_terminal_key>
TBANK_TERMINAL_PASSWORD=<your_terminal_password>

# Telegram бот
TG_BOT_ENABLED=false
TG_BOT_TOKEN=<your_telegram_bot_token>

# Почта (SMTP)
SMTP_MAIL_SERVER_HOST=<your_smtp_host>
SMTP_MAIL_SERVER_PORT=587
SMTP_MAIL_SERVER_USE_TLS=True
MAIL_ADDRESS=<your_email@domain.com>
MAIL_SENDER_NAME=<YourStoreName>
MAIL_PASSWORD=<your_email_app_password>

# GeoLite2
GEOLITE_DB_PATH=configs/GeoLite2-City.mmdb

# Информация о проекте
PROJECT_NAME=ZovOceana
DEPLOY_FULL_URL=https://zovoceana.ru
DEPLOY_SHORT_URL=zovoceana.ru

# ---------- Опциональные настройки (можно расскомментировать и поменять то, что нужно) ----------
